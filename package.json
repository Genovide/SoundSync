{
  "name": "soundsync-build",
  "private": true,
  "version": "1.2.12",
  "description": "SoundSync desktop player — Windows and macOS builds",
  "scripts": {
    "build:mac": "node scripts/build-macos.mjs",
    "test:source": "node scripts/check-source.cjs",
    "test:mac": "node scripts/smoke-macos.mjs",
    "archive:mac": "node scripts/archive-macos.mjs",
    "build:windows": "node scripts/build-windows.mjs",
    "test:palette": "node scripts/test-cover-palette.cjs",
    "test:interface": "node scripts/run-interface-test.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:lyrics": "node scripts/test-lyrics-timing.cjs",
    "test:taste": "node scripts/test-taste-model.cjs"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "15.15.0",
    "prettier": "3.10.0",
    "rcedit": "5.0.2"
  }
}
